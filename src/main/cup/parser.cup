package com.olc1;

import java.util.ArrayList;
import java.util.List;

import java_cup.runtime.Symbol;

import com.olc1.ast.ASTNode;
import com.olc1.ast.exp.*;
import com.olc1.ast.stm.*;
import com.olc1.reports.GoLiteError;

parser code {:
    public List<GoLiteError> errors = new ArrayList<>();

    public void syntax_error(Symbol s) {
        String tok = s.value != null ? s.value.toString() : "";
        errors.add(new GoLiteError("sintáctico",
            "Token inesperado '" + tok + "'", s.left, s.right));
    }

    public void unrecovered_syntax_error(Symbol s) throws Exception {
        String tok = s.value != null ? s.value.toString() : "";
        errors.add(new GoLiteError("sintáctico",
            "Error sintáctico no recuperable cerca de '" + tok + "'", s.left, s.right));
    }
:}

terminal kwIf, kwElse, kwFor, kwBreak, kwContinue, kwVar, kwFunc, kwNil, kwRange;
terminal kwTrue, kwFalse;
terminal kwSwitch, kwCase, kwDefault, colon;
terminal UMINUS;
terminal kwInt, kwFloat, kwBool, kwString, kwRune;
terminal fmt_println, strconv_atoi, strconv_parsefloat, reflect_typeof;
terminal walrus_assign, plus_assign, minus_assign;
terminal eq, neq, leq, geq, lt, gt;
terminal and, or, not;
terminal plus, minus, times, slash, mod, plusplus, minusminus;
terminal assign;
terminal lparen, rparen, lbrace, rbrace, scol, comma;
terminal kwStruct, kwReturn, kwAppend, kwSlicesIndex, kwStringsJoin, kwLen, lbracket, rbracket, dot, kwType;
terminal String id;
terminal String integer;
terminal String decimal;
terminal String string;
terminal String rune;

nonterminal ASTNode INICIO, INSTRUCCION, EXPRESION, SIMPLE_STMT;
nonterminal ASTNode ASSIGN_VALUE;
nonterminal Statments INSTRUCCIONES;
nonterminal ASTNode ELSE_IF_ELSE;
nonterminal List<ASTNode> CASE_LIST;
nonterminal ASTNode CASE;
nonterminal List<ASTNode> ARGS, LISTA_ARGS;
nonterminal Object OP_SCOL;
nonterminal String TYPE;
nonterminal String NON_ID_TYPE;
nonterminal List<FieldDecl> FIELD_LIST;
nonterminal FieldDecl FIELD_DECL;
nonterminal List<Param> PARAM_LIST, PARAMS;
nonterminal Param PARAM;
nonterminal List<ASTNode> BRACE_CONTENT, BRACE_LIST;
nonterminal ASTNode BRACE_ELEMENT;
nonterminal String OPT_RETURN_TYPE;

precedence left or;
precedence left and;
precedence left eq, neq;
precedence left lt, leq, gt, geq;
precedence left plus, minus;
precedence left times, slash, mod;
precedence right not, UMINUS;
precedence left dot, lbracket, rbracket, lparen, rparen;

start with INICIO;

INICIO ::= INSTRUCCIONES:i
    {: RESULT = i; :}
;

INSTRUCCIONES ::= INSTRUCCIONES:is INSTRUCCION:i
    {: is.add(i); RESULT = is; :}
    | /* vacío */
    {: RESULT = new Statments(); :}
;

OP_SCOL ::= scol | /* vacío */ ;

INSTRUCCION ::=
    kwVar id:n TYPE:t OP_SCOL
    {: RESULT = new VarDecl(n, t, null, nleft, nright); :}
    | kwVar id:n TYPE:t assign ASSIGN_VALUE:e OP_SCOL
    {: RESULT = new VarDecl(n, t, e, nleft, nright); :}
    | kwVar id:n TYPE:t walrus_assign ASSIGN_VALUE:e OP_SCOL
    {: RESULT = new VarDecl(n, t, e, nleft, nright); :}
    | id:n walrus_assign ASSIGN_VALUE:e OP_SCOL
    {: RESULT = new ShortDecl(n, e, nleft, nright); :}
    | EXPRESION:target assign ASSIGN_VALUE:e OP_SCOL
    {: RESULT = new Assign(target, e, targetleft, targetright); :}
    | EXPRESION:target plus_assign EXPRESION:e OP_SCOL
    {: RESULT = new PlusAssign(target, e, targetleft, targetright); :}
    | EXPRESION:target minus_assign EXPRESION:e OP_SCOL
    {: RESULT = new MinusAssign(target, e, targetleft, targetright); :}
    | EXPRESION:target plusplus OP_SCOL
    {: RESULT = new PlusAssign(target, new Integers(1, targetleft, targetright), targetleft, targetright); :}
    | EXPRESION:target minusminus OP_SCOL
    {: RESULT = new MinusAssign(target, new Integers(1, targetleft, targetright), targetleft, targetright); :}
    | kwType id:n kwStruct lbrace FIELD_LIST:fields rbrace OP_SCOL
    {: RESULT = new StructDeclNode(n, fields, nleft, nright); :}
    | kwStruct id:n lbrace FIELD_LIST:fields rbrace OP_SCOL
    {: RESULT = new StructDeclNode(n, fields, nleft, nright); :}
    | NON_ID_TYPE:t id:n assign ASSIGN_VALUE:e OP_SCOL
    {: RESULT = new VarDecl(n, t, e, tleft, tright); :}
    | NON_ID_TYPE:t id:n OP_SCOL
    {: RESULT = new VarDecl(n, t, null, tleft, tright); :}
    | id:t id:n assign ASSIGN_VALUE:e OP_SCOL
    {: RESULT = new VarDecl(n, t, e, tleft, tright); :}
    | id:t id:n OP_SCOL
    {: RESULT = new VarDecl(n, t, null, tleft, tright); :}
    | kwFunc id:n lparen PARAMS:p rparen OPT_RETURN_TYPE:ret lbrace INSTRUCCIONES:body rbrace OP_SCOL
    {: RESULT = new FuncDeclNode(n, p, ret, body, nleft, nright); :}
    | kwFunc lparen PARAM:r rparen id:n lparen PARAMS:p rparen OPT_RETURN_TYPE:ret lbrace INSTRUCCIONES:body rbrace OP_SCOL
    {: RESULT = new MethodDeclNode(r, n, p, ret, body, rleft, rright); :}
    | kwReturn:kReturn ASSIGN_VALUE:e OP_SCOL
    {: RESULT = new ReturnNode(e, kReturnleft, kReturnright); :}
    | kwReturn:kReturn OP_SCOL
    {: RESULT = new ReturnNode(null, kReturnleft, kReturnright); :}
    | kwIf EXPRESION:c lbrace INSTRUCCIONES:b rbrace ELSE_IF_ELSE:el
    {: RESULT = new IfNode(c, b, el, cleft, cright); :}
    | kwFor:kFor SIMPLE_STMT:init scol EXPRESION:cond scol SIMPLE_STMT:incr lbrace INSTRUCCIONES:b rbrace
    {: RESULT = new ForNode(init, cond, incr, b, kForleft, kForright); :}
    | kwFor:kFor EXPRESION:cond lbrace INSTRUCCIONES:b rbrace
    {: RESULT = new ForWhileNode(cond, b, kForleft, kForright); :}
    | kwFor:kFor lbrace INSTRUCCIONES:b rbrace
    {: RESULT = new ForWhileNode(new BoolLiteral(true, kForleft, kForright), b, kForleft, kForright); :}
    | kwFor:kFor id:id1 comma id:id2 walrus_assign kwRange EXPRESION:c lbrace INSTRUCCIONES:b rbrace
    {: RESULT = new ForRangeNode(id1, id2, true, c, b, kForleft, kForright); :}
    | kwFor:kFor id:id1 comma id:id2 assign kwRange EXPRESION:c lbrace INSTRUCCIONES:b rbrace
    {: RESULT = new ForRangeNode(id1, id2, false, c, b, kForleft, kForright); :}
    | kwFor:kFor id:id1 walrus_assign kwRange EXPRESION:c lbrace INSTRUCCIONES:b rbrace
    {: RESULT = new ForRangeNode(id1, null, true, c, b, kForleft, kForright); :}
    | kwFor:kFor id:id1 assign kwRange EXPRESION:c lbrace INSTRUCCIONES:b rbrace
    {: RESULT = new ForRangeNode(id1, null, false, c, b, kForleft, kForright); :}
    | kwFor:kFor kwRange EXPRESION:c lbrace INSTRUCCIONES:b rbrace
    {: RESULT = new ForRangeNode(null, null, false, c, b, kForleft, kForright); :}
    | kwBreak:kBreak OP_SCOL
    {: RESULT = new BreakNode(kBreakleft, kBreakright); :}
    | kwContinue:kContinue OP_SCOL
    {: RESULT = new ContinueNode(kContinueleft, kContinueright); :}
    | EXPRESION:e OP_SCOL
    {: RESULT = new ExprStatment(e, eleft, eright); :}
    | lbrace INSTRUCCIONES:b rbrace OP_SCOL
    {: RESULT = b; :}
    | kwSwitch:s EXPRESION:e lbrace CASE_LIST:cl rbrace
    {: RESULT = new SwitchNode(e, cl, sleft, sright); :}
    | error rbrace
    {: RESULT = new Statments(); :}
    | error scol
    {: RESULT = new Statments(); :}
;

ELSE_IF_ELSE ::=
    kwElse:kElse kwIf EXPRESION:c lbrace INSTRUCCIONES:b rbrace ELSE_IF_ELSE:el
    {: RESULT = new ElseIfPart(c, b, el, kElseleft, kElseright); :}
    | kwElse:kElse lbrace INSTRUCCIONES:b rbrace
    {: RESULT = new ElsePart(b, kElseleft, kElseright); :}
    | /* vacío */
    {: RESULT = null; :}
;

CASE_LIST ::=
    CASE_LIST:cl CASE:c
    {: cl.add(c); RESULT = cl; :}
    | /* vacío */
    {: RESULT = new ArrayList<ASTNode>(); :}
;

CASE ::=
    kwCase EXPRESION:e colon INSTRUCCIONES:body
    {: RESULT = new CaseNode(e, body, eleft, eright); :}
    | kwDefault:d colon INSTRUCCIONES:body
    {: RESULT = new CaseNode(null, body, dleft, dright); :}
;

SIMPLE_STMT ::=
    EXPRESION:target assign ASSIGN_VALUE:e
    {: RESULT = new Assign(target, e, targetleft, targetright); :}
    | id:n walrus_assign ASSIGN_VALUE:e
    {: RESULT = new ShortDecl(n, e, nleft, nright); :}
    | EXPRESION:target plus_assign EXPRESION:e
    {: RESULT = new PlusAssign(target, e, targetleft, targetright); :}
    | EXPRESION:target minus_assign EXPRESION:e
    {: RESULT = new MinusAssign(target, e, targetleft, targetright); :}
    | EXPRESION:target plusplus
    {: RESULT = new PlusAssign(target, new Integers(1, targetleft, targetright), targetleft, targetright); :}
    | EXPRESION:target minusminus
    {: RESULT = new MinusAssign(target, new Integers(1, targetleft, targetright), targetleft, targetright); :}
    | EXPRESION:e
    {: RESULT = new ExprStatment(e, eleft, eright); :}
;

ARGS ::=
    id:t lbrace BRACE_CONTENT:c rbrace LISTA_ARGS:l
    {: l.add(0, new StructLiteralNode(t, c, tleft, tright)); RESULT = l; :}
    | EXPRESION:e LISTA_ARGS:l
    {: l.add(0, e); RESULT = l; :}
    | /* vacío */
    {: RESULT = new ArrayList<ASTNode>(); :}
;

LISTA_ARGS ::=
    comma id:t lbrace BRACE_CONTENT:c rbrace LISTA_ARGS:l
    {: l.add(0, new StructLiteralNode(t, c, tleft, tright)); RESULT = l; :}
    | comma EXPRESION:e LISTA_ARGS:l
    {: l.add(0, e); RESULT = l; :}
    | /* vacío */
    {: RESULT = new ArrayList<ASTNode>(); :}
;

EXPRESION ::=
    EXPRESION:a plus EXPRESION:b
    {: RESULT = new Add(a, b); :}
    | EXPRESION:a minus EXPRESION:b
    {: RESULT = new Sub(a, b); :}
    | EXPRESION:a times EXPRESION:b
    {: RESULT = new Mul(a, b); :}
    | EXPRESION:a slash EXPRESION:b
    {: RESULT = new Div(a, b); :}
    | EXPRESION:a mod EXPRESION:b
    {: RESULT = new Mod(a, b); :}
    | EXPRESION:a eq EXPRESION:b
    {: RESULT = new Equ(a, b); :}
    | EXPRESION:a neq EXPRESION:b
    {: RESULT = new Nequ(a, b); :}
    | EXPRESION:a lt EXPRESION:b
    {: RESULT = new Lesser(a, b); :}
    | EXPRESION:a leq EXPRESION:b
    {: RESULT = new LesserEqu(a, b); :}
    | EXPRESION:a gt EXPRESION:b
    {: RESULT = new Greater(a, b); :}
    | EXPRESION:a geq EXPRESION:b
    {: RESULT = new GreaterEqu(a, b); :}
    | EXPRESION:a and EXPRESION:b
    {: RESULT = new And(a, b); :}
    | EXPRESION:a or EXPRESION:b
    {: RESULT = new Or(a, b); :}
    | not EXPRESION:e
    {: RESULT = new Not(e); :}
    | minus EXPRESION:e 
    {: RESULT = new Negate(e); :} %prec UMINUS
    | lparen EXPRESION:e rparen
    {: RESULT = new Paren(e); :}
    | kwTrue:t
    {: RESULT = new BoolLiteral(true, tleft, tright); :}
    | kwFalse:f
    {: RESULT = new BoolLiteral(false, fleft, fright); :}
    | kwNil:n
    {: RESULT = new NilLiteral(nleft, nright); :}
    | id:n
    {: RESULT = new VarRef(n, nleft, nright); :}
    | integer:e
    {: RESULT = new Integers(Integer.parseInt(e), eleft, eright); :}
    | decimal:e
    {: RESULT = new Decimal(Double.parseDouble(e), eleft, eright); :}
    | string:s
    {: RESULT = new StringLiteral(s, sleft, sright); :}
    | fmt_println:fmt lparen ARGS:a rparen
    {: RESULT = new FmtPrintln(a, fmtleft, fmtright); :}
    | strconv_atoi:str lparen EXPRESION:e rparen
    {: RESULT = new StrconvAtoi(e, strleft, strright); :}
    | strconv_parsefloat:str lparen EXPRESION:e rparen
    {: RESULT = new StrconvParseFloat(e, strleft, strright); :}
    | reflect_typeof:reflect lparen EXPRESION:e rparen
    {: RESULT = new ReflectTypeOf(e, reflectleft, reflectright); :}
    | rune:r
    {: RESULT = new RuneLiteral(r, rleft, rright); :}
    | id:name lparen ARGS:a rparen
    {: RESULT = new FuncCallNode(name, a, nameleft, nameright); :}
    | EXPRESION:target dot id:name lparen ARGS:a rparen
    {: RESULT = new MethodCallNode(target, name, a, targetleft, targetright); :}
    | EXPRESION:target dot id:name
    {: RESULT = new FieldAccessNode(target, name, targetleft, targetright); :}
    | EXPRESION:target lbracket EXPRESION:idx rbracket
    {: RESULT = new SliceAccessNode(target, idx, targetleft, targetright); :}
    | kwAppend:k lparen EXPRESION:s comma EXPRESION:v rparen
    {: RESULT = new AppendNode(s, v, kleft, kright); :}
    | kwSlicesIndex:k lparen EXPRESION:s comma EXPRESION:v rparen
    {: RESULT = new SlicesIndexNode(s, v, kleft, kright); :}
    | kwStringsJoin:k lparen EXPRESION:s comma EXPRESION:sep rparen
    {: RESULT = new StringsJoinNode(s, sep, kleft, kright); :}
    | kwLen:k lparen EXPRESION:s rparen
    {: RESULT = new LenNode(s, kleft, kright); :}
    | lbracket:l rbracket TYPE:t lbrace BRACE_CONTENT:c rbrace
    {: RESULT = new SliceLiteralNode("[]" + t, c, lleft, lright); :}
;

ASSIGN_VALUE ::=
    id:t lbrace BRACE_CONTENT:c rbrace
    {: RESULT = new StructLiteralNode(t, c, tleft, tright); :}
    | lbrace:l BRACE_CONTENT:c rbrace
    {: RESULT = new BraceLiteralNode(c, lleft, lright); :}
    | EXPRESION:e
    {: RESULT = e; :}
;

NON_ID_TYPE ::= kwInt    {: RESULT = "int"; :}
              | kwFloat  {: RESULT = "float64"; :}
              | kwBool   {: RESULT = "bool"; :}
              | kwString {: RESULT = "string"; :}
              | kwRune   {: RESULT = "rune"; :}
              | lbracket rbracket TYPE:t {: RESULT = "[]" + t; :}
;

TYPE ::= NON_ID_TYPE:t {: RESULT = t; :}
       | id:name        {: RESULT = name; :}
;

FIELD_DECL ::= id:name TYPE:t OP_SCOL
    {: RESULT = new FieldDecl(name, t); :}
    | TYPE:t id:name OP_SCOL
    {: RESULT = new FieldDecl(name, t); :}
;

FIELD_LIST ::= FIELD_LIST:l FIELD_DECL:f
    {: l.add(f); RESULT = l; :}
    | /* vacío */
    {: RESULT = new ArrayList<FieldDecl>(); :}
;

PARAM ::= id:name TYPE:t
    {: RESULT = new Param(name, t); :}
;

PARAMS ::= PARAM:p PARAM_LIST:l
    {: l.add(0, p); RESULT = l; :}
    | /* vacío */
    {: RESULT = new ArrayList<Param>(); :}
;

PARAM_LIST ::= comma PARAM:p PARAM_LIST:l
    {: l.add(0, p); RESULT = l; :}
    | /* vacío */
    {: RESULT = new ArrayList<Param>(); :}
;

BRACE_ELEMENT ::= EXPRESION:e
    {: RESULT = e; :}
    | id:name colon EXPRESION:e
    {: RESULT = new FieldInit(name, e); :}
    | id:t lbrace BRACE_CONTENT:c rbrace
    {: RESULT = new StructLiteralNode(t, c, tleft, tright); :}
    | id:name colon id:t lbrace BRACE_CONTENT:c rbrace
    {: RESULT = new FieldInit(name, new StructLiteralNode(t, c, tleft, tright)); :}
    | lbrace:l BRACE_CONTENT:c rbrace
    {: RESULT = new BraceLiteralNode(c, lleft, lright); :}
    | id:name colon lbrace:l BRACE_CONTENT:c rbrace
    {: RESULT = new FieldInit(name, new BraceLiteralNode(c, lleft, lright)); :}
;

BRACE_CONTENT ::= BRACE_ELEMENT:e BRACE_LIST:l
    {: l.add(0, e); RESULT = l; :}
    | /* vacío */
    {: RESULT = new ArrayList<ASTNode>(); :}
;

BRACE_LIST ::= comma BRACE_ELEMENT:e BRACE_LIST:l
    {: l.add(0, e); RESULT = l; :}
    | comma
    {: RESULT = new ArrayList<ASTNode>(); :}
    | /* vacío */
    {: RESULT = new ArrayList<ASTNode>(); :}
;

OPT_RETURN_TYPE ::= TYPE:t
    {: RESULT = t; :}
    | /* vacío */
    {: RESULT = null; :}
;